# ============================================================
# offer-web-scrapper — local development environment
# NEVER commit this file. It is in .gitignore.
# ============================================================

# ----- Database (Neon) -----
# Neon console → your project → Connection Details
# Pooled (for app runtime queries)
DATABASE_URL=

# Direct / unpooled (for drizzle-kit migrations only)
DATABASE_URL_UNPOOLED=

# ----- HuggingFace (embeddings) -----
# huggingface.co → Settings → Access Tokens → New token (Inference preset)
HUGGINGFACE_API_KEY=

# ----- QStash (Upstash) -----
# Upstash console → QStash → your queue
# Note: QSTASH_URL is not used by the app (SDK derives endpoint from token)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ----- Resend (email notifications) -----
# Resend dashboard → API Keys
RESEND_API_KEY=

# Verified sender address on your Resend domain
RESEND_FROM_EMAIL=

# ----- Browserless -----
# Browserless dashboard or self-hosted URL
BROWSERLESS_URL=wss://chrome.browserless.io
BROWSERLESS_TOKEN=

# ----- Groq (LLM scoring) -----
# console.groq.com → API Keys
GROQ_API_KEY=

# Optional: override the Groq model used for scoring (default: llama-3.1-8b-instant)
# SCORING_MODEL=llama-3.1-8b-instant

# ----- Security -----
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ----- App URL -----
# Your Vercel production domain (set after DEPLOY-01)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Upstash Redis (rate limiting) -----
# Provisioned in DEVOPS-04 — leave blank until then
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
