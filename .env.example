# ============================================================
# offer-web-scrapper — local development environment
# NEVER commit this file. It is in .gitignore.
# ============================================================

# ----- Database (Neon) -----
# Neon console → your project → Connection Details
# Pooled (for app runtime queries)
DATABASE_URL=

# Direct / unpooled (for drizzle-kit migrations only)
DATABASE_URL_UNPOOLED=

# ----- Ollama (Hetzner VPS) -----
# Full URL including Basic Auth credentials: https://user:pass@ollama.yourdomain.com
OLLAMA_BASE_URL=

# Caddy Basic Auth username (AI-01)
OLLAMA_USER=

# Caddy Basic Auth password (AI-01)
OLLAMA_PASSWORD=

# Non-secret — model names
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# ----- QStash (Upstash) -----
# Upstash console → QStash → your queue
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ----- Resend (email notifications) -----
# Resend dashboard → API Keys
RESEND_API_KEY=

# Verified sender address on your Resend domain
RESEND_FROM_EMAIL=

# ----- Browserless -----
# Browserless dashboard or self-hosted URL
BROWSERLESS_URL=wss://chrome.browserless.io
BROWSERLESS_TOKEN=

# ----- Groq (LLM scoring) -----
# console.groq.com → API Keys
GROQ_API_KEY=

# ----- Security -----
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ----- App URL -----
# Your Vercel production domain (set after DEPLOY-01)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- Upstash Redis (rate limiting) -----
# Provisioned in DEVOPS-04 — leave blank until then
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
